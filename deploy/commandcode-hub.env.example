NODE_ENV=production
HUB_HOST=127.0.0.1
HUB_PORT=3050
INTERNAL_PROXY_PORT=3051
HUB_DATA_DIR=/var/lib/commandcode-hub
COMMAND_CODE_AUTH_FILE=/root/.commandcode/auth.json

# Generate each value separately with: openssl rand -hex 32
GATEWAY_API_KEY=replace-with-a-long-random-client-key
ADMIN_PASSWORD=replace-with-a-strong-admin-password
MASTER_KEY=replace-with-a-long-random-encryption-key
SESSION_SECRET=replace-with-a-different-random-session-key

CC_MAX_BODY_MB=8
CC_MAX_INFLIGHT=4
CC_STREAM_IDLE_MS=180000
CC_NONSTREAM_IDLE_MS=180000
QUOTA_REFRESH_MS=300000
QUOTA_RETENTION_DAYS=90
REQUEST_RETENTION_DAYS=7
